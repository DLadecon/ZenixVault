# ─────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in every value.
# NEVER commit `.env`. None of these are exposed to the browser.
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/scripthub"

# Public URL of the site (used for sitemap, canonical URLs, Open Graph)
SITE_URL="http://localhost:3000"

# ── Admin login ──────────────────────────────────────────────
# Choose your admin username.
ADMIN_USERNAME="owner"
# Base64 of a bcrypt hash. Generate it with:  npm run hash-password
ADMIN_PASSWORD_HASH_B64=""

# Random string, 32+ chars, used to sign the admin session cookie.
# Generate with:  npm run gen-secret
SESSION_SECRET=""

# ── Optional ─────────────────────────────────────────────────
# Where uploaded thumbnails are stored (must be persistent storage).
# UPLOAD_DIR="./uploads"

# Set to "true" ONLY when testing a production build over plain http://localhost.
# INSECURE_COOKIES="false"
